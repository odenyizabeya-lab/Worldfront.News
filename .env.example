# WorldFront.News environment configuration
# Copy this file to .env and fill in your values.

# Server port
PORT=3000

# Public site URL (used for SEO/sitemap/canonical and the apex->www redirect).
# The site keeps working with a different domain or hosting provider by changing
# only this value. The canonical host is https://www.worldfront.news.
SITE_URL=https://www.worldfront.news

# Optional: Google Site Verification token (domain verification in Search Console).
# When set, the matching <meta name="google-site-verification"> is injected into every
# page and /google/<token>.html is served for file-based verification.
GOOGLE_SITE_VERIFICATION=

# Admin default password for the seeded 'admin' account (used only on first seed)
ADMIN_PASSWORD=admin123

# --- Optional API news providers (free tiers available). RSS feeds are primary. ---
# NewsData.io -> https://newsdata.io  (free tier, generous)
NEWSDATA_API_KEY=
# NewsAPI.org -> https://newsapi.org  (free tier limited to dev)
NEWSAPI_KEY=
# GNews.io -> https://gnews.io (free tier)
GNEWS_KEY=

# Set to 1 to disable the scheduled 15-minute news ingestion
DISABLE_CRON=0

# --- Weverse Shop Updates (auto-publishing of products) ---
# Your shop's catalog is read through its official, read-only Supabase REST API.
# These use the shop's publishable client key (already public in the shop's own
# front-end; it can only read, never write). Override with your own values.
WEVERSE_SHOP_SUPABASE_URL=
WEVERSE_SHOP_ANON_KEY=
WEVERSE_SHOP_BASE_URL=https://weverseonlineshop.com

# --- Vercel (deploy + cron) ---
# Vercel Cron (vercel.json) authenticates /api/cron/* endpoints via the
# x-vercel-cron header; the hourly GitHub Actions fallback (hourly.yml) uses a
# bearer token. Set HOURLY_CRON_TOKEN to the same value in GitHub Actions
# secrets AND in the Vercel project environment.
HOURLY_CRON_TOKEN=

# --- Vercel self-rebuild (server/integrations/deploy.js) ---
# Preferred: a Vercel Deploy Hook URL (public, no token). POSTing to it rebuilds
# the latest production deployment so the build pipeline re-generates the
# bundled DB (build-regenerate.js) with that day's complete editions.
DEPLOY_HOOK_URL=

# Fallback: official Vercel REST API path (used only when DEPLOY_HOOK_URL is
# empty). Requires a Vercel API token with access to the project.
DEPLOY_TOKEN=
DEPLOY_TEAM=odenyizabeya-lab
DEPLOY_PROJECT_ID=
