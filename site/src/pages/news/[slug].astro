---
// Dynamic article route, server-side rendered on Cloudflare.
// Fetches the article from Neon Postgres by slug, emits pure HTML.
import { eq } from 'drizzle-orm';
import { configureTursoFromRuntime, getDb } from '../../db/client';
import { articles } from '../../db/schema';

configureTursoFromRuntime(Astro.locals.runtime?.env);
const db = getDb();

const { slug } = Astro.params;
const [article] = slug
  ? await db.select().from(articles).where(eq(articles.slug, slug))
  : [];

if (!article) {
  Astro.response.status = 404;
}

const publishedISO = article?.published_at.toISOString() ?? null;
const author = article?.author ?? null;
const category = article?.category ?? null;
const summary = article ? article.content.replace(/\s+/g, ' ').trim().slice(0, 160) : '';

// Content body: split paragraphs on blank lines. Text is auto-escaped by Astro
// (no client JS, no user HTML is ever interpreted).
const paragraphs = (article?.content ?? '').split(/\r?\n\s*\r?\n|\r?\n/).filter((p) => p.trim());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{article ? `${article.title} | WorldFront.News` : 'Article not found | WorldFront.News'}</title>
    <meta name="description" content={summary || 'WorldFront.News — trusted news from every country in the world.'} />
    <link rel="canonical" href={`https://www.worldfront.news/news/${slug ?? ''}`} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={article?.title ?? 'Article not found'} />
    <meta property="og:description" content={summary} />
    {article?.featured_image && <meta property="og:image" content={article.featured_image} />}
    <meta property="og:url" content={`https://www.worldfront.news/news/${slug ?? ''}`} />
    <meta name="twitter:card" content={article?.featured_image ? 'summary_large_image' : 'summary'} />

    {
      article && (
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "NewsArticle",
          "headline": article.title,
          "author": { "@type": "Person", "name": author ?? 'Editorial' },
          "datePublished": publishedISO,
          "dateModified": publishedISO,
          "image": article.featured_image || undefined,
          "articleSection": category ?? 'news',
          "mainEntityOfPage": `https://www.worldfront.news/news/${slug}`
        })} />
      )
    }
  </head>
  <body>
    {
      article ? (
        <>
          {article.featured_image && (
            <figure style="margin:0 0 1rem">
              <img
                src={article.featured_image}
                alt={article.title}
                width={article.image_width ?? 1200}
                height={article.image_height ?? 630}
                loading="eager"
                fetchpriority="high"
              />
            </figure>
          )}
          <p class="category">{category}</p>
          <h1>{article.title}</h1>
          <p class="byline">
            {author ? `By ${author}` : 'Editorial'}
            {publishedISO ? ` · ${new Date(publishedISO).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}` : null}
          </p>
          <article>
            {paragraphs.map((p) => <p>{p}</p>)}
          </article>
        </>
      ) : (
        <main style="padding:3rem 1rem;text-align:center">
          <h1>Article not found</h1>
          <p>The story you are looking for does not exist or may have been moved.</p>
          <p><a href="/">Back to the front page</a></p>
        </main>
      )
    }
  </body>
</html>

<style is:global>
  body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; max-width: 720px; margin: 0 auto; padding: 1.5rem; line-height: 1.6; color: #111; }
  .category { text-transform: uppercase; letter-spacing: .05em; font-size: .8rem; color: #b00; margin-bottom: .5rem; }
  h1 { font-size: 2rem; line-height: 1.2; margin: 0 0 .75rem; }
  .byline { color: #555; font-size: .9rem; }
  article p { margin: 0 0 .9rem; }
</style>