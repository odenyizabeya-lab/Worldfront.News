# Turso (libSQL) database. Free up to 500 DBs / 9 GB at https://turso.tech
# CLI:  turso auth login
#       turso db create worldfront
#       turso db show --url worldfront          # -> TURSO_DATABASE_URL
#       turso db tokens create worldfront      # -> TURSO_AUTH_TOKEN
#
# Cloudflare Pages: apply these two values as Production secrets (no .env file
# on the deploy). They arrive on Astro.locals.runtime.env at request time.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
#
# Local libsql server (same Turso protocol, no cloud), Docker:
#   docker run -d --name wf-turso -p 18080:8080 -v wfsqld:/var/lib/sqld \
#     ghcr.io/tursodatabase/libsql-server:v0.24.32
#   TURSO_DATABASE_URL=http://127.0.0.1:18080
#   TURSO_AUTH_TOKEN=